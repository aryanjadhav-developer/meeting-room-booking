{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CabinBooking": "Data Source=CabinBooking.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true
  },
  "Demo": {
    "Enabled": true
  },
  "Jwt": {
    "Issuer": "CabinBooking",
    "Audience": "CabinBooking",
    "SigningKey": "CabinBooking-Default-Development-Signing-Key-2026-AtLeast32Chars",
    "ExpiryHours": 12
  },
  "Auth": {
    "AllowedEmailDomains": []
  },
  "Admin": {
    "Email": "demo.admin@example.com",
    "Password": "DemoAdmin123!",
    "Name": "Administrator"
  },
  "BookingRules": {
    "TimeZoneId": "Asia/Kolkata",
    "Projects": [ "Project Alpha", "Project Beta", "Project Gamma" ],
    "OfficeStart": "09:00",
    "OfficeEnd": "20:00",
    "WorkingDays": [ "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" ],
    "SlotMinutes": 15,
    "MinDurationMinutes": 15,
    "MaxDurationMinutes": 240,
    "MaxDaysAhead": 30,
    "MaxBookingsPerUserPerDay": 0,
    "CheckInOpensMinutesBefore": 5,
    "AutoReleaseEnabled": false,
    "CheckInGraceMinutes": 10
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  }
}
